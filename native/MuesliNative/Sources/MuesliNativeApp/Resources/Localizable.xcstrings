    "meeting_templates.weekly_team_meeting.prompt": {
      "comment": "native/MuesliNative/Sources/MuesliNativeApp/MeetingTemplates.swift",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use this structure exactly:\n\n## Weekly Overview\nA concise summary of the most important updates from the meeting.\n\n## Progress Updates\n- Key workstreams and status changes\n\n## Decisions\n- Decisions made or confirmed\n\n## Risks and Open Questions\n- Issues that need attention or follow-up\n\n## Action Items\n- [ ] Tasks, owners, and timing if mentioned"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa exactamente esta estructura:\n\n## Resumen semanal\nUn resumen conciso de las actualizaciones más importantes de la reunión.\n\n## Avances\n- Líneas de trabajo clave y cambios de estado\n\n## Decisiones\n- Decisiones tomadas o confirmadas\n\n## Riesgos y preguntas abiertas\n- Temas que requieren atención o seguimiento\n\n## Tareas pendientes\n- [ ] Tareas, responsables y plazos si se mencionaron"
          }
        }
      }
    },
