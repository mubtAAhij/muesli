    "meeting_templates.stand_up.prompt": {
      "comment": "native/MuesliNative/Sources/MuesliNativeApp/MeetingTemplates.swift",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use this structure exactly:\n\n## Yesterday\n- Work completed or progress since the last update\n\n## Today\n- Planned work or priorities for today\n\n## Blockers\n- Risks, delays, or dependencies\n\n## Coordination Notes\n- Decisions, asks, or cross-team alignment points"
          }
        }
