    "backend_option.whisper_large_turbo.description": {
      "comment": "native/MuesliNative/Sources/MuesliNativeApp/Models.swift",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisper's strongest multilingual option. Better for mixed languages and difficult audio, with a larger download and more processing time than Small. Auto-detect language by default, or pin a language."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La opción multilingüe más potente de Whisper. Maneja mejor los idiomas mezclados y el audio difícil, pero implica una descarga mayor y más tiempo de procesamiento que Small. Detecta el idioma automáticamente por defecto, o fija uno en particular."
          }
        }
      }
    },
