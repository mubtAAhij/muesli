    "backend_option.cohere_transcribe.description": {
      "comment": "native/MuesliNative/Sources/MuesliNativeApp/Models.swift",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The most deliberate option for difficult accents and tricky audio. It supports 14 languages and can be more accurate than faster models, but the download is large and you only see the result after you stop speaking."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La opción más meticulosa para acentos difíciles y audio complicado. Admite 14 idiomas y puede ser más precisa que los modelos más rápidos, pero la descarga es pesada y solo ves el resultado cuando dejas de hablar."
          }
        }
      }
    },
