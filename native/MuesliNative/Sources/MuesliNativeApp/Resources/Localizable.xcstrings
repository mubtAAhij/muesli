    },
    "meeting_templates.one_to_one.prompt": {
      "comment": "native/MuesliNative/Sources/MuesliNativeApp/MeetingTemplates.swift",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use this structure exactly:\n\n## Check-In\nA brief summary of how the conversation opened and the overall tone.\n\n## Topics Discussed\n- Main themes raised by either person\n\n## Support Needed\n- Blockers, concerns, or asks for help\n\n## Commitments\n- [ ] Follow-ups or commitments made by either person\n\n## Manager Notes\n- Coaching, feedback, or context that should be remembered"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa exactamente esta estructura:\n\n## Check-In\nUn breve resumen de cómo abrió la conversación y el tono general.\n\n## Temas tratados\n- Temas principales planteados por cualquiera de las dos personas\n\n## Apoyo necesario\n- Bloqueos, preocupaciones o solicitudes de ayuda\n\n## Compromisos\n- [ ] Seguimientos o compromisos asumidos por cualquiera de las dos personas\n\n## Notas del manager\n- Coaching, retroalimentación o contexto que se debe recordar"
          }
        }
      }
    },
    "meeting_templates.customer_discovery.title": {
      "comment": "native/MuesliNative/Sources/MuesliNativeApp/MeetingTemplates.swift",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Customer: Discovery"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliente: Descubrimiento"
          }
        }
      }
    },
    "meeting_templates.customer_discovery.category": {
      "comment": "native/MuesliNative/Sources/MuesliNativeApp/MeetingTemplates.swift",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Commercial"
