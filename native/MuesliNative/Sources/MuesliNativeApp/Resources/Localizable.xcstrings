    "meeting_templates.auto.prompt": {
      "comment": "Localized string",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use this structure exactly:\n\n## Meeting Summary\nA 2-3 sentence overview of what was discussed.\n\n## Key Discussion Points\n- Bullet points of the main topics discussed\n\n## Decisions Made\n- Bullet points of any decisions reached\n\n## Action Items\n- [ ] Bullet points of tasks assigned or agreed upon, with owners if mentioned\n\n## Notable Quotes\n- Any important or notable statements, if applicable"
          }
        }
      }
    },
    "meeting_templates.one_to_one.title": {
      "comment": "Localized string",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1 to 1"
          }
        }
      }
    },
    "meeting_templates.one_to_one.category": {
      "comment": "Localized string",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Team"
          }
        }
      }
    },
    "meeting_templates.one_to_one.prompt": {
      "comment": "Localized string",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use this structure exactly:\n\n## Check-In\nA brief summary of how the conversation opened and the overall tone.\n\n## Topics Discussed\n- Main themes raised by either person\n\n## Support Needed\n- Blockers, concerns, or asks for help\n\n## Commitments\n- [ ] Follow-ups or commitments made by either person\n\n## Manager Notes\n- Coaching, feedback, or context that should be remembered"
          }
        }
      }
    },
    "meeting_templates.customer_discovery.title": {
      "comment": "Localized string",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Customer: Discovery"
          }
        }
      }
    },
    "meeting_templates.customer_discovery.category": {
      "comment": "Localized string",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Commercial"
          }
        }
      }
    },
    "meeting_templates.customer_discovery.prompt": {
      "comment": "Localized string",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use this structure exactly:\n\n## Customer Context\n- Company, role, or situation if mentioned\n\n## Problems and Pain Points\n- Explicit frustrations, blockers, or unmet needs\n\n## Current Workflow\n- How they currently solve the problem today\n\n## Buying Signals\n- Indicators of urgency, budget, timing, or decision process\n\n## Next Steps\n- [ ] Follow-up actions, owners, and dates if mentioned"
          }
        }
      }
    },
    "meeting_templates.hiring.title": {
      "comment": "Localized string",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiring"
          }
        }
      }
    },
    "meeting_templates.hiring.category": {
      "comment": "Localized string",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recruiting"
