      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A compact option covering more than 50 languages, with punctuation included in the result. Quality varies by language and accent, so try it with your own voice before relying on it."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Una opción compacta que cubre más de 50 idiomas, con puntuación incluida en el resultado. La calidad varía según el idioma y el acento, así que pruébalo con tu propia voz antes de depender de él."
          }
