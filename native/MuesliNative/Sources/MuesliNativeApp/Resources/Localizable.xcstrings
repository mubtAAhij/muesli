    "meeting_templates.auto.title": {
      "comment": "Title for the automatic meeting template.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto"
          }
        }
      }
    },
    "meeting_templates.auto.prompt": {
      "comment": "Prompt template text for auto meeting summary format.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use this structure exactly:\n\n## Meeting Summary\nA 2-3 sentence overview of what was discussed.\n\n## Key Discussion Points\n- Bullet points of the main topics discussed\n\n## Decisions Made\n- Bullet points of any decisions reached\n\n## Action Items\n- [ ] Bullet points of tasks assigned or agreed upon, with owners if mentioned\n\n## Notable Quotes\n- Any important or notable statements, if applicable"
          }
        }
      }
    },
    "meeting_templates.one_to_one.title": {
      "comment": "Title for one-to-one meeting template.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1 to 1"
          }
        }
      }
    },
    "meeting_templates.category.team": {
      "comment": "Category label for team-related meeting templates.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Team"
          }
        }
      }
    },
    "meeting_templates.one_to_one.prompt": {
      "comment": "Prompt template text for one-to-one meeting format.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use this structure exactly:\n\n## Check-In\nA brief summary of how the conversation opened and the overall tone.\n\n## Topics Discussed\n- Main themes raised by either person\n\n## Support Needed\n- Blockers, concerns, or asks for help\n\n## Commitments\n- [ ] Follow-ups or commitments made by either person\n\n## Manager Notes\n- Coaching, feedback, or context that should be remembered"
          }
        }
      }
    },
    "meeting_templates.customer_discovery.title": {
      "comment": "Title for customer discovery meeting template.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Customer: Discovery"
          }
        }
      }
    },
    "meeting_templates.customer_discovery.category": {
      "comment": "Category label for customer discovery template.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Commercial"
          }
        }
      }
    },
    "meeting_templates.customer_discovery.prompt": {
      "comment": "Prompt template text for customer discovery meeting format.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use this structure exactly:\n\n## Customer Context\n- Company, role, or situation if mentioned\n\n## Problems and Pain Points\n- Explicit frustrations, blockers, or unmet needs\n\n## Current Workflow\n- How they currently solve the problem today\n\n## Buying Signals\n- Indicators of urgency, budget, timing, or decision process\n\n## Next Steps\n- [ ] Follow-up actions, owners, and dates if mentioned"
          }
        }
      }
    },
    "meeting_templates.hiring.title": {
      "comment": "Title for hiring meeting template.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiring"
          }
        }
      }
    },
    "meeting_templates.hiring.category": {
      "comment": "Category label for hiring template.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recruiting"
          }
        }
      }
    },
    "meeting_templates.hiring.prompt": {
      "comment": "Prompt template text for hiring meeting format.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use this structure exactly:\n\n## Candidate Snapshot\nA concise overview of the candidate and relevant background.\n\n## Strengths\n- Positive signals from the conversation\n\n## Concerns\n- Risks, gaps, or open questions\n\n## Role Fit\n- Why they do or do not fit the role as discussed\n\n## Decision and Next Steps\n- [ ] Hiring decision, interview progression, or follow-up items"
          }
        }
      }
    },
    "meeting_templates.stand_up.title": {
      "comment": "Title for stand-up meeting template.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand-Up"
          }
        }
      }
    },
    "meeting_templates.stand_up.prompt": {
      "comment": "Prompt template text for stand-up meeting format.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use this structure exactly:\n\n## Yesterday\n- Work completed or progress since the last update\n\n## Today\n- Planned work or priorities for today\n\n## Blockers\n- Risks, delays, or dependencies\n\n## Coordination Notes\n- Decisions, asks, or cross-team alignment points"
          }
        }
      }
    },
