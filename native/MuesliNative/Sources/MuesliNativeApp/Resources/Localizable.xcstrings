    "computer_use_planner.recovery.browser_automation_permission_guidance": {
      "comment": "native/MuesliNative/Sources/MuesliNativeApp/ComputerUsePlannerRuntime.swift",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Continue with get_app_state plus AX/screenshot tools: click_element/click_point, paste_text/type_text, press_key/hotkey, and scroll. Do not retry browser page tools unless the user grants Chrome Apple Events JavaScript permission."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Continúa con get_app_state más las herramientas AX/captura de pantalla: click_element/click_point, paste_text/type_text, press_key/hotkey y scroll. No vuelvas a intentar las herramientas de página del navegador a menos que el usuario otorgue el permiso de JavaScript de Apple Events de Chrome."
          }
        }
      }
    },
    "computer_use_planner.recovery.text_entry_retry_guidance": {
      "comment": "native/MuesliNative/Sources/MuesliNativeApp/ComputerUsePlannerRuntime.swift",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Continue with get_app_state and focus an editable target using click_element or set_value before retrying text entry. Prefer paste_text for Apple Notes and native rich-text editors. Do not repeat text entry until the focused target changes."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Continúa con get_app_state y enfoca un objetivo editable usando click_element o set_value antes de reintentar la entrada de texto. Prefiere paste_text para Apple Notes y editores de texto enriquecido nativos. No repitas la entrada de texto hasta que el objetivo enfocado cambie."
          }
        }
      }
    },
