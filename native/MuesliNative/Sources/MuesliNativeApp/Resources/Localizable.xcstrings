          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Subtítulos rápidos en inglés mientras una reunión está en curso. Son una vista previa provisional; tu modelo de reunión habitual crea la transcripción que conservas."
          }
        }
      }
