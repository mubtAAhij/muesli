    "backend_option.parakeet_v2.description": {
      "comment": "native/MuesliNative/Sources/MuesliNativeApp/Models.swift",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A quick, dependable English-only option. Choose it if you mainly dictate in English and prefer the older Parakeet model."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Una opción rápida y confiable, solo en inglés. Elígela si dictas principalmente en inglés y prefieres el modelo Parakeet anterior."
          }
        }
      }
    },
