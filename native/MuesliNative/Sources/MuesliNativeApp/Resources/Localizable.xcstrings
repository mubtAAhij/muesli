    "models.streaming.description": {
      "comment": "native/MuesliNative/Sources/MuesliNativeApp/ModelsView.swift",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose how words appear while a meeting is in progress. Nemotron also creates the saved transcript; Parakeet prioritizes a faster English preview."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige cómo aparecen las palabras mientras una reunión está en curso. Nemotron también crea la transcripción guardada; Parakeet prioriza una vista previa en inglés más rápida."
          }
        }
      }
    },
    "models.live_caption.description": {
