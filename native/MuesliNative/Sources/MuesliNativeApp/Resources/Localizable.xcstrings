    "backend_option.indic_asr.description": {
      "comment": "native/MuesliNative/Sources/MuesliNativeApp/Models.swift",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Built specifically for seven Indian languages. Choose your language before recording; it can help where general multilingual models struggle, but results still vary enough to keep it experimental."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Diseñado específicamente para siete idiomas de la India. Elige tu idioma antes de grabar; puede rendir mejor donde los modelos multilingüe generales tienen dificultades, pero los resultados varían lo suficiente como para seguir considerándolo experimental."
          }
        }
      }
    },
