    "meeting_templates.auto.prompt": {
      "comment": "native/MuesliNative/Sources/MuesliNativeApp/MeetingTemplates.swift",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use this structure exactly:\n\n## Meeting Summary\nA 2-3 sentence overview of what was discussed.\n\n## Key Discussion Points\n- Bullet points of the main topics discussed\n\n## Decisions Made\n- Bullet points of any decisions reached\n\n## Action Items\n- [ ] Bullet points of tasks assigned or agreed upon, with owners if mentioned\n\n## Notable Quotes\n- Any important or notable statements, if applicable"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa exactamente esta estructura:\n\n## Resumen de la reunión\nUn resumen de 2 a 3 oraciones sobre lo que se trató.\n\n## Puntos clave de la conversación\n- Viñetas con los temas principales discutidos\n\n## Decisiones tomadas\n- Viñetas con las decisiones alcanzadas\n\n## Tareas pendientes\n- [ ] Viñetas con las tareas asignadas o acordadas, con responsables si se mencionaron\n\n## Citas destacadas\n- Declaraciones importantes o relevantes, si aplica"
          }
        }
      }
    },
    "meeting_templates.one_to_one.title": {
      "comment": "native/MuesliNative/Sources/MuesliNativeApp/MeetingTemplates.swift",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1 to 1"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "1 a 1"
          }
        }
      }
    },
    "meeting_templates.category.team": {
      "comment": "native/MuesliNative/Sources/MuesliNativeApp/MeetingTemplates.swift",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Team"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Equipo"
