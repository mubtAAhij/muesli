    },
    "meeting_templates.customer_discovery.prompt": {
      "comment": "native/MuesliNative/Sources/MuesliNativeApp/MeetingTemplates.swift",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use this structure exactly:\n\n## Customer Context\n- Company, role, or situation if mentioned\n\n## Problems and Pain Points\n- Explicit frustrations, blockers, or unmet needs\n\n## Current Workflow\n- How they currently solve the problem today\n\n## Buying Signals\n- Indicators of urgency, budget, timing, or decision process\n\n## Next Steps\n- [ ] Follow-up actions, owners, and dates if mentioned"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa exactamente esta estructura:\n\n## Contexto del cliente\n- Empresa, rol o situación si se mencionaron\n\n## Problemas y puntos críticos\n- Frustraciones, bloqueos o necesidades no cubiertas mencionadas explícitamente\n\n## Flujo de trabajo actual\n- Cómo resuelven el problema hoy en día\n\n## Señales de compra\n- Indicadores de urgencia, presupuesto, plazos o proceso de decisión\n\n## Próximos pasos\n- [ ] Acciones de seguimiento, responsables y fechas si se mencionaron"
          }
        }
      }
    },
    "meeting_templates.hiring.title": {
      "comment": "native/MuesliNative/Sources/MuesliNativeApp/MeetingTemplates.swift",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiring"
          }
        },
        "es-419": {
