    "update_guidance.message.manual_install_instructions": {
      "comment": "native/MuesliNative/Sources/MuesliNativeApp/AppDelegate.swift",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please quit Muesli, reopen it from Applications, and try the update once more.\n\nIf this keeps happening, download the latest DMG and replace Muesli manually. This can happen when the local updater cannot finish preparing or replacing the app."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, cierra Muesli, vuelve a abrirlo desde Aplicaciones e intenta la actualización de nuevo.\n\nSi esto sigue pasando, descarga el DMG más reciente y reemplaza Muesli manualmente. Esto puede ocurrir cuando el actualizador local no puede terminar de preparar o reemplazar la aplicación."
          }
        }
      }
    },
