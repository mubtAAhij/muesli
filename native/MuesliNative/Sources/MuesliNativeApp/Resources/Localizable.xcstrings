    },
    "backend_option.whisper_tiny.description": {
      "comment": "native/MuesliNative/Sources/MuesliNativeApp/Models.swift",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The quickest Whisper download and lightest multilingual option for occasional notes. It gives up some accuracy on accents, noise, and longer speech. Auto-detect language by default, or choose one yourself."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La descarga de Whisper más rápida y la opción multilingüe más liviana para notas ocasionales. Sacrifica algo de precisión con acentos, ruido y habla más prolongada. Detecta el idioma automáticamente por defecto, o elige uno tú mismo."
          }
        }
      }
    },
