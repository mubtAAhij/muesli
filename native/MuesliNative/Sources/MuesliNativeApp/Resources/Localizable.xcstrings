        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "## Transcripción sin procesar\n\nRecuperada desde los puntos de control de la transcripción en vivo porque la reunión no finalizó normalmente. Esta recuperación puede estar incompleta y puede no incluir la diarización final ni la reconciliación.\n\n%@"
          }
        }
      }
    },
