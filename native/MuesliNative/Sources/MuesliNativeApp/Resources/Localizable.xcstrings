    "backend_option.qwen3_asr.description": {
      "comment": "native/MuesliNative/Sources/MuesliNativeApp/Models.swift",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strong multilingual transcription across 52 languages when accuracy matters more than instant results. Expect a short 2–3 second wait compared with Parakeet, and about 30 seconds of one-time preparation the first time it runs."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcripción multilingüe sólida en 52 idiomas cuando la precisión importa más que los resultados inmediatos. Espera una breve pausa de 2–3 segundos en comparación con Parakeet, y unos 30 segundos de preparación única la primera vez que se ejecuta."
          }
        }
      }
    },
