    "settings.calendars.sources.explanation": {
      "comment": "native/MuesliNative/Sources/MuesliNativeApp/SettingsView.swift",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar sources are listed first, with their calendars underneath. Disabled calendars are hidden from Muesli — no notifications, no Coming Up, no meeting detection."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fuentes de calendario aparecen primero, con sus calendarios debajo. Los calendarios deshabilitados se ocultan de Muesli — sin notificaciones, sin Coming Up, sin detección de reuniones."
          }
        }
      }
    },
    "settings.calendars.none_detected_permission_hint": {
      "comment": "native/MuesliNative/Sources/MuesliNativeApp/SettingsView.swift",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No calendars detected. Make sure Calendar permission is granted in System Settings > Privacy & Security > Calendars."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "No se detectaron calendarios. Asegúrate de que el permiso de Calendario esté otorgado en Configuración del Sistema > Privacidad y Seguridad > Calendarios."
          }
        }
      }
    },
    "settings.calendars.google_duplicates_explanation": {
      "comment": "native/MuesliNative/Sources/MuesliNativeApp/SettingsView.swift",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Google calendars may appear once from macOS Calendar and once from Muesli's Google connection. Turn off both copies to hide that calendar completely."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Los calendarios de Google pueden aparecer una vez desde Calendario de macOS y otra vez desde la conexión de Muesli con Google. Desactiva ambas copias para ocultar ese calendario por completo."
          }
        }
      }
    },
