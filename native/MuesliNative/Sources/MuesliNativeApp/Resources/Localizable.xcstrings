    "backend_option.apple_speech.description": {
      "comment": "native/MuesliNative/Sources/MuesliNativeApp/Models.swift",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple's private, on-device speech model for macOS 26. It is designed for dictation, meetings, distant speakers, and long recordings, while macOS manages the language assets and updates."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo de voz privado y en el dispositivo de Apple para macOS 26. Está diseñado para dictado, reuniones, hablantes a distancia y grabaciones largas, mientras macOS gestiona los recursos de idioma y las actualizaciones."
          }
        }
      }
    },
