        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The quickest English-only Whisper option for lightweight notes. Choose it when you always speak English and do not need automatic language detection."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La opción Whisper más rápida, exclusiva para inglés y pensada para notas ligeras. Elige esta opción si siempre hablas en inglés y no necesitas detección automática de idioma."
          }
        }
