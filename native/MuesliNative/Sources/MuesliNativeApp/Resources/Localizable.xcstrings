    "backend_option.nemotron35_multilingual.description": {
      "comment": "native/MuesliNative/Sources/MuesliNativeApp/Models.swift",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live text appears as you speak in more than 100 locales, including Hindi, Chinese, and Japanese, with language auto-detection and punctuation. It works for hold-to-talk, hands-free dictation, and meetings, but it only appends words—it does not go back to correct earlier text."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto aparece en tiempo real mientras hablas en más de 100 idiomas y regiones, incluidos Hindi, Chino y Japonés, con detección automática de idioma y puntuación. Funciona con pulsar para hablar, dictado manos libres y reuniones, pero solo agrega palabras—no vuelve atrás para corregir texto anterior."
          }
        }
      }
    },
    "backend_option.cohere_transcribe.title": {
