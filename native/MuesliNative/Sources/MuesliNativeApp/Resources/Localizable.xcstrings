            "state": "translated",
            "value": "Contratación"
          }
        }
      }
    },
    "meeting_templates.hiring.category": {
      "comment": "native/MuesliNative/Sources/MuesliNativeApp/MeetingTemplates.swift",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recruiting"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Reclutamiento"
          }
        }
      }
    },
    "meeting_templates.hiring.prompt": {
      "comment": "native/MuesliNative/Sources/MuesliNativeApp/MeetingTemplates.swift",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use this structure exactly:\n\n## Candidate Snapshot\nA concise overview of the candidate and relevant background.\n\n## Strengths\n- Positive signals from the conversation\n\n## Concerns\n- Risks, gaps, or open questions\n\n## Role Fit\n- Why they do or do not fit the role as discussed\n\n## Decision and Next Steps\n- [ ] Hiring decision, interview progression, or follow-up items"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa exactamente esta estructura:\n\n## Resumen del candidato\nUn resumen conciso del candidato y sus antecedentes relevantes.\n\n## Fortalezas\n- Señales positivas de la conversación\n\n## Preocupaciones\n- Riesgos, brechas o preguntas abiertas\n\n## Adecuación al puesto\n- Por qué encaja o no en el rol según lo conversado\n\n## Decisión y próximos pasos\n- [ ] Decisión de contratación, avance en el proceso de entrevistas o tareas de seguimiento"
          }
        }
      }
    },
    "meeting_templates.stand_up.title": {
      "comment": "native/MuesliNative/Sources/MuesliNativeApp/MeetingTemplates.swift",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand-Up"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand-Up"
          }
        }
      }
    },
    "meeting_templates.stand_up.prompt": {
      "comment": "native/MuesliNative/Sources/MuesliNativeApp/MeetingTemplates.swift",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use this structure exactly:\n\n## Yesterday\n- Work completed or progress since the last update\n\n## Today\n- Planned work or priorities for today\n\n## Blockers\n- Risks, delays, or dependencies\n\n## Coordination Notes\n- Decisions, asks, or cross-team alignment points"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa exactamente esta estructura:\n\n## Ayer\n- Trabajo completado o avances desde la última actualización\n\n## Hoy\n- Trabajo planificado o prioridades para hoy\n\n## Bloqueos\n- Riesgos, retrasos o dependencias\n\n## Notas de coordinación\n- Decisiones, solicitudes o puntos de alineación entre equipos"
          }
        }
      }
    },
    "meeting_templates.weekly_team_meeting.title": {
      "comment": "native/MuesliNative/Sources/MuesliNativeApp/MeetingTemplates.swift",
