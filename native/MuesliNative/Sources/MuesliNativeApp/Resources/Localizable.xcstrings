    "backend_option.parakeet_v3.description": {
      "comment": "native/MuesliNative/Sources/MuesliNativeApp/Models.swift",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The best default for everyday dictation: quick enough to feel responsive, reliable in normal rooms, and able to follow 25 languages."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La mejor opción predeterminada para el dictado cotidiano: lo suficientemente rápido como para sentirse ágil, confiable en entornos normales y compatible con 25 idiomas."
          }
        }
      }
    },
